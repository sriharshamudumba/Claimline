OPENAI_API_KEY=sk-...
# Use the same realtime model you run in VistaVoice
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin
# Optional. Leave empty if you lack access; only the caller-side transcript is affected.
# whisper-1 is widely available if you want it.
TRANSCRIBE_MODEL=
CARRIER_NAME=Claimline

# Public demo guardrails (set DEMO_ACCESS_CODE before sharing a URL)
DEMO_ACCESS_CODE=
CALLS_PER_IP_PER_HOUR=6
CALLS_PER_DAY=60
MAX_CALL_MINUTES=8

# Conversational fillers: play "mm-hmm" if the agent is silent this long after you stop talking. 0 = off.
FILLER_MS=500

# Speed: minimal reasoning gives the fastest replies on gpt-realtime-2.x models
REASONING_EFFORT=minimal
# Turn ending: semantic (waits for a finished thought) or server (fixed pause)
TURN_DETECTION=semantic
VAD_EAGERNESS=high
SILENCE_MS=500
